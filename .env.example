# Algorand 25-word wallet mnemonic for paying x402 challenges
# Example: "word1 word2 word3 ... word25"
ALGORAND_MNEMONIC="word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24 word25"

# Optional alternative: base64-encoded 64-byte private key
# AVM_PRIVATE_KEY=""

# Automatically sign x402 payments without preview confirmation in MCP (default: false)
# When false: Claude/MCP will ask for confirmation before signing transactions
# When true: Payments are signed and settled immediately
MODU_MCP_AUTO_PAY=false

# Algorand CAIP-2 network identifier (defaults to Algorand TestNet)
# TestNet: algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
# MainNet: algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73k
NETWORK=algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=

# Modu edge proxy URL
MODU_PROXY_URL=https://modu-proxy.onrender.com

# Modu control plane URL
MODU_CONTROL_PLANE_URL=https://modu-to68.onrender.com

# Facilitator URL
FACILITATOR_URL=https://facilitator.goplausible.xyz
