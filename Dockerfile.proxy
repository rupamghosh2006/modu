# ==========================================
# modu Edge Reverse Proxy — Multi-stage Dockerfile
# ==========================================

FROM node:20-alpine AS builder
WORKDIR /app

# Copy root manifests and workspace configs
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/tsconfig.json ./packages/shared/
COPY packages/proxy/package.json packages/proxy/tsconfig.json ./packages/proxy/
COPY packages/control-plane/package.json ./packages/control-plane/
COPY packages/cli/package.json ./packages/cli/

# Install dependencies
RUN npm ci

# Copy source trees
COPY packages/shared ./packages/shared
COPY packages/proxy ./packages/proxy

# Compile TypeScript packages
RUN npm run --prefix packages/shared build
RUN npm run --prefix packages/proxy build

# ==========================================
# Production Runtime Stage
# ==========================================
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=4000
ENV HOST=0.0.0.0

# Install curl for container health checks
RUN apk add --no-cache curl

# Copy workspace dependencies and compiled output
COPY --from=builder /app/package.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/packages/proxy ./packages/proxy

USER node

EXPOSE 4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT:-4000}/health || exit 1

CMD ["node", "packages/proxy/dist/server.js"]
